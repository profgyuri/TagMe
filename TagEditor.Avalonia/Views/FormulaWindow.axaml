<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TagEditor.Avalonia.ViewModels"
        x:DataType="vm:FormulaViewModel"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="350"
        Width="400" Height="350"
        x:Class="TagEditor.Avalonia.Views.FormulaWindow"
        Title="FormulaWindow">
    
    <Design.DataContext>
        <vm:FormulaViewModel />
    </Design.DataContext>
    
    <Grid RowDefinitions="Auto * Auto"
          Margin="8">
        <TextBox Grid.Row="0"
                 Text="{Binding Formula}"/>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Ok"
                    Click="OkButton_OnClick"
                    Width="80" HorizontalContentAlignment="Center" Margin="0 0 16 0"/>
            <Button Content="Cancel"
                    Click="CancelButton_OnClick"
                    Width="80" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
