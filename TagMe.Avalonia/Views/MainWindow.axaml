<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:icons="using:Material.Icons.Avalonia"
        xmlns:viewModels="clr-namespace:TagMe.Avalonia.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TagMe.Avalonia.Views.MainWindow"
        x:DataType="viewModels:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="TagEditor">

    <Design.DataContext>
        <viewModels:MainViewModel />
    </Design.DataContext>
    
    <Window.Resources>
        <ContextMenu x:Key="ColumnHeaderMenu" x:Name="ColumnHeaderMenu">
            <ContextMenu.Styles>
                <Style Selector="MenuItem" x:DataType="DataGridColumn">
                    <Setter Property="Header" Value="{Binding Header}" />
                    <Setter Property="ToggleType" Value="CheckBox" />
                    <Setter Property="IsChecked" Value="{Binding IsVisible, Mode=TwoWay}" />
                    <Setter Property="StaysOpenOnClick" Value="True" />
                </Style>
            </ContextMenu.Styles>
        </ContextMenu>
    </Window.Resources>

    <Grid RowDefinitions="Auto *">
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <!-- Controls -->
            <Button Click="AddFiles_OnClick"
                    ToolTip.Tip="Add files">
                <icons:MaterialIcon Kind="FileDocumentAdd"/>
            </Button>
            <Button Click="AddFolder_OnClick"
                    ToolTip.Tip="Add folder">
                <icons:MaterialIcon Kind="FolderAdd"/>
            </Button>
            <Button Command="{Binding ClearGridCommand}" 
                    ToolTip.Tip="Clear grid">
                <icons:MaterialIcon Kind="ClearCircle"/>
            </Button>
            <Separator Width="5"/>
            <Button Click="TagsToFilename_OnClick"
                    ToolTip.Tip="Tags to filename">
                <StackPanel Orientation="Horizontal">
                    <icons:MaterialIcon Kind="Tag"/>
                    <icons:MaterialIcon Kind="ArrowRight"/>
                    <icons:MaterialIcon Kind="FileDocument"/>
                </StackPanel>
            </Button>
            <Button Click="FilenameToTags_OnClick"
                    ToolTip.Tip="Filename to tags">
                <StackPanel Orientation="Horizontal">
                    <icons:MaterialIcon Kind="FileDocument"/>
                    <icons:MaterialIcon Kind="ArrowRight"/>
                    <icons:MaterialIcon Kind="Tag"/>
                </StackPanel>
            </Button>
            <Separator Width="5"/>
            <Button Click="MoveFiles_OnClick"
                    ToolTip.Tip="Move files">
                <icons:MaterialIcon Kind="FileDocumentMove"/>
            </Button>
        </StackPanel>
        
        <DataGrid Grid.Row="1" x:Name="Grid"
                  ItemsSource="{Binding TrackList}"
                  SelectionChanged="Grid_OnSelectionChanged"
                  AutoGenerateColumns="False"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  CanUserSortColumns="True"
                  SelectionMode="Extended">
            <DataGrid.Styles>
                <Style Selector="DataGridColumnHeader">
                    <Setter Property="ContextMenu" Value="{StaticResource ColumnHeaderMenu}" />
                </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Artists" Binding="{Binding ArtistsDisplay, UpdateSourceTrigger=LostFocus}" />
                <DataGridTextColumn Header="Title" Binding="{Binding Title, UpdateSourceTrigger=LostFocus}" />
                <DataGridTextColumn Header="Genres" Binding="{Binding GenresDisplay, UpdateSourceTrigger=LostFocus}" />
                <DataGridTextColumn Header="BPM" Binding="{Binding Bpm, UpdateSourceTrigger=LostFocus}" />
                <DataGridTextColumn Header="Bitrate" Binding="{Binding BitRate}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Sample Rate" Binding="{Binding SampleRate}" IsReadOnly="True"/>
                <DataGridTextColumn Header="File Name" Binding="{Binding FileName, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Path" Binding="{Binding Path}" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>

</Window>
