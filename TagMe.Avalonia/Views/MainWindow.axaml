<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:icons="using:Material.Icons.Avalonia"
        xmlns:viewModels="clr-namespace:TagMe.Avalonia.ViewModels"
        xmlns:models="clr-namespace:TagMe.Avalonia.Models"
        mc:Ignorable="d" 
        Background="{DynamicResource WindowBackgroundBrush}"
        Width="700" Height="450" MinWidth="450" MinHeight="250"
        x:Class="TagMe.Avalonia.Views.MainWindow"
        x:DataType="viewModels:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="TagEditor">

    <Design.DataContext>
        <viewModels:MainViewModel />
    </Design.DataContext>
    
    <Window.Resources>
        <ContextMenu x:Key="ColumnHeaderMenu" x:Name="ColumnHeaderMenu">
            <ContextMenu.Styles>
                <Style Selector="MenuItem" x:DataType="DataGridColumn">
                    <Setter Property="Header" Value="{Binding Header}" />
                    <Setter Property="ToggleType" Value="CheckBox" />
                    <Setter Property="IsChecked" Value="{Binding IsVisible, Mode=TwoWay}" />
                    <Setter Property="StaysOpenOnClick" Value="True" />
                </Style>
            </ContextMenu.Styles>
        </ContextMenu>
    </Window.Resources>

    <Grid RowDefinitions="Auto Auto *" Margin="0 8 0 0">
        <StackPanel Grid.Row="0" 
                    Orientation="Horizontal" 
                    Spacing="6" 
                    HorizontalAlignment="Center"
                    Margin="0 0 0 8">
            <!-- Controls -->
            <Button Click="AddFiles_OnClick"
                    ToolTip.Tip="Add files"
                    Classes="header">
                <icons:MaterialIcon Kind="FileDocumentAdd"/>
            </Button>
            <Button Click="AddFolder_OnClick"
                    ToolTip.Tip="Add folder"
                    Classes="header">
                <icons:MaterialIcon Kind="FolderAdd"/>
            </Button>
            <Button Command="{Binding ClearGridCommand}" 
                    ToolTip.Tip="Clear grid"
                    Classes="header">
                <icons:MaterialIcon Kind="ClearCircle"/>
            </Button>
            <Separator Width="5" Margin="4"/>
            <Button Click="TagsToFilename_OnClick"
                    ToolTip.Tip="Tags to filename"
                    Classes="header">
                <StackPanel Orientation="Horizontal">
                    <icons:MaterialIcon Kind="Tag"/>
                    <icons:MaterialIcon Kind="ArrowRight"/>
                    <icons:MaterialIcon Kind="FileDocument"/>
                </StackPanel>
            </Button>
            <Button Click="FilenameToTags_OnClick"
                    ToolTip.Tip="Filename to tags"
                    Classes="header">
                <StackPanel Orientation="Horizontal">
                    <icons:MaterialIcon Kind="FileDocument"/>
                    <icons:MaterialIcon Kind="ArrowRight"/>
                    <icons:MaterialIcon Kind="Tag"/>
                </StackPanel>
            </Button>
            <Separator Width="5" Margin="4"/>
            <Button Click="MoveFiles_OnClick"
                    ToolTip.Tip="Move files"
                    Classes="header">
                <icons:MaterialIcon Kind="FileDocumentMove"/>
            </Button>
        </StackPanel>
        
        <Grid Grid.Row="1" ColumnDefinitions="Auto *">
            <TextBlock Grid.Column="0" Text="Filter:" Margin="0 6 0 0"/>
            <TextBox Grid.Column="1" 
                     Text="{Binding FilterText}"
                     Classes="filter"/>
        </Grid>
        
        <DataGrid Grid.Row="2" x:Name="Grid"
                  ItemsSource="{Binding TrackList}"
                  SelectionChanged="Grid_OnSelectionChanged"
                  AutoGenerateColumns="False"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="True"
                  SelectionMode="Extended"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  BorderThickness="0 1 0 0"
                  BorderBrush="#444">
            <DataGrid.Styles>
                <Style Selector="DataGridColumnHeader">
                    <Setter Property="ContextMenu" Value="{StaticResource ColumnHeaderMenu}"/>
                    <Setter Property="Background" Value="{DynamicResource ColumnHeaderBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=Foreground}"/>
                </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Artists" Binding="{Binding ArtistsDisplay, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Title, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Genres" Binding="{Binding GenresDisplay, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="BPM" Binding="{Binding Bpm, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Bitrate" Binding="{Binding BitRate}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Sample Rate" Binding="{Binding SampleRate}" IsReadOnly="True"/>
                <DataGridTextColumn Header="File Name" Binding="{Binding FileName, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Path" Binding="{Binding Path}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Artists' Roles" Binding="{Binding ArtistsRoleDisplay, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Album Artists" Binding="{Binding AlbumArtistsDisplay, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Composers" Binding="{Binding ComposersDisplay, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Album" Binding="{Binding Album, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Comment" Binding="{Binding Comment, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Year" Binding="{Binding Year, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Track no." Binding="{Binding TrackNumber, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Disc no." Binding="{Binding DiscNumber, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Lyrics" Binding="{Binding Lyrics, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Grouping" Binding="{Binding Grouping, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Conductor" Binding="{Binding Conductor, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Copyright" Binding="{Binding Copyright, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Album Gain" Binding="{Binding ReplayGainAlbumGain, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Album Peak" Binding="{Binding ReplayGainAlbumPeak, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Track Gain" Binding="{Binding ReplayGainTrackGain, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Track Peak" Binding="{Binding ReplayGainTrackPeak, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Initial Key" Binding="{Binding InitialKey, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Remixed By" Binding="{Binding RemixedBy, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="ISRC" Binding="{Binding ISRC, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Length" Binding="{Binding Length, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Bits per Sample" Binding="{Binding BitsPerSample}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Audio Channels" Binding="{Binding AudioChannels}" IsReadOnly="True"/>
                <DataGridTextColumn Header="MusicBrainz Artist ID" Binding="{Binding MusicBrainzArtistId, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="MusicBrainz Track ID" Binding="{Binding MusicBrainzTrackId, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="MusicBrainz Disc ID" Binding="{Binding MusicBrainzDiscId, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="MusicBrainz Release Artist ID" Binding="{Binding MusicBrainzReleaseArtistId, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="MusicBrainz Release Country" Binding="{Binding MusicBrainzReleaseCountry, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="MusicBrainz Release Group ID" Binding="{Binding MusicBrainzReleaseGroupId, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="MusicBrainz Release ID" Binding="{Binding MusicBrainzReleaseId, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="MusicBrainz Release Status" Binding="{Binding MusicBrainzReleaseStatus, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="MusicBrainz Release Type" Binding="{Binding MusicBrainzReleaseType, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="MusicIP ID" Binding="{Binding MusicIpId, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTextColumn Header="Amazon ID" Binding="{Binding AmazonId, UpdateSourceTrigger=LostFocus}"/>
                <DataGridTemplateColumn Header="Cover">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="models:Track">
                            <Button Click="ChangeCoverButton_OnClick" Padding="0" HorizontalAlignment="Center">
                                <Image Source="{Binding Cover}" Width="26" Height="26" Stretch="UniformToFill" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>

</Window>
