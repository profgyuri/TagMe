<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:TagMe.Avalonia.ViewModels"
        x:DataType="viewModels:FormulaViewModel"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="350"
        Width="400" Height="350"
        WindowStartupLocation="CenterOwner"
        x:Class="TagMe.Avalonia.Views.FormulaWindow"
        Title="Formula Editor">
    
    <Design.DataContext>
        <viewModels:FormulaViewModel />
    </Design.DataContext>
    
    <Grid RowDefinitions="Auto * Auto" Margin="8">
        <TextBox Grid.Row="0" x:Name="FormulaTextBox" 
                 Text="{Binding Formula, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.ContextMenu>
                <ContextMenu>
                    <!-- We add only the fields that make at least a little sense - the rest can be edited manually -->
                    <MenuItem Click="ContextMenuItem_OnClick" Header="Album"/>
                    <MenuItem Click="ContextMenuItem_OnClick" Header="AlbumArtists"/>
                    <MenuItem Click="ContextMenuItem_OnClick" Header="Artists"/>
                    <MenuItem Click="ContextMenuItem_OnClick" Header="ArtistsRoles"/>
                    <MenuItem Click="ContextMenuItem_OnClick" Header="AudioChannels"/>
                    <MenuItem Click="ContextMenuItem_OnClick" Header="BitsPerSample" IsEnabled="{Binding IsTagsToFilename}"/>
                    <MenuItem Click="ContextMenuItem_OnClick" Header="BitRate" IsEnabled="{Binding IsTagsToFilename}"/>
                    <MenuItem Click="ContextMenuItem_OnClick" Header="Bpm"/>
                    <MenuItem Click="ContextMenuItem_OnClick" Header="Comment"/>
                    <MenuItem Click="ContextMenuItem_OnClick" Header="Composers"/>
                    <MenuItem Click="ContextMenuItem_OnClick" Header="Conductor"/>
                    <MenuItem Click="ContextMenuItem_OnClick" Header="Copyright"/>
                    <MenuItem Click="ContextMenuItem_OnClick" Header="DiscNumber"/>
                    <MenuItem Click="ContextMenuItem_OnClick" Header="Filename" IsEnabled="{Binding IsTagsToFilename}"/>
                    <MenuItem Click="ContextMenuItem_OnClick" Header="Genres"/>
                    <MenuItem Click="ContextMenuItem_OnClick" Header="Grouping"/>
                    <MenuItem Click="ContextMenuItem_OnClick" Header="InitialKey"/>
                    <MenuItem Click="ContextMenuItem_OnClick" Header="Length"/>
                    <MenuItem Click="ContextMenuItem_OnClick" Header="Publisher"/>
                    <MenuItem Click="ContextMenuItem_OnClick" Header="RemixedBy"/>
                    <MenuItem Click="ContextMenuItem_OnClick" Header="SampleRate" IsEnabled="{Binding IsTagsToFilename}"/>
                    <MenuItem Click="ContextMenuItem_OnClick" Header="Title"/>
                    <MenuItem Click="ContextMenuItem_OnClick" Header="TrackNumber"/>
                    <MenuItem Click="ContextMenuItem_OnClick" Header="Year"/>
                </ContextMenu>
            </TextBox.ContextMenu>
        </TextBox>
        
        <ItemsControl Grid.Row="1" ItemsSource="{Binding ReadTags}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="75, *">
                        <Line Grid.Column="0" Grid.ColumnSpan="2"/>
                        <TextBlock Grid.Column="0" Text="{Binding Key}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Ok"
                    Click="OkButton_OnClick"
                    Width="80" HorizontalContentAlignment="Center" Margin="0 0 16 0"/>
            <Button Content="Cancel"
                    Click="CancelButton_OnClick"
                    Width="80" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
